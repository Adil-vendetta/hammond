# Copy to .env.local for local development, or add these in Vercel > Project > Settings > Environment Variables.

# Your live website address (no trailing slash). Used for canonical links, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://hammond.edu.au

# Set to "true" on preview/staging deployments so Google does not index them. Remove (or set "false") on the live site.
NEXT_PUBLIC_NOINDEX=true

# ---- Where enquiry forms are sent (set up at least one) ----
# Option A – email via SMTP (your email provider or IT person can supply these)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ENQUIRY_TO=info@hammond.edu.au
MAIL_FROM="Hammond Institute Website <no-reply@hammond.edu.au>"

# Option B – send each enquiry as JSON to a CRM, Zapier, Make or similar webhook
ENQUIRY_WEBHOOK_URL=
